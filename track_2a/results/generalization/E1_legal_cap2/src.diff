+        keep, used = {0}, len(chunks[0])
+        for p in ranked:
+            i = p["index"]
+            if i not in keep and used + len(chunks[i]) <= config.REFERENCE_MAX_CHARS:
+                keep.add(i)
+                used += len(chunks[i])
+        return [chunks[i] for i in sorted(keep)], usage
