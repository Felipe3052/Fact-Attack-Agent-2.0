# The submission configuration, written out explicitly. The Docker image sets none of these variables, so the
# submission runs on the defaults in src/config.py; this file states them so that a local run cannot silently
# pick up other values from a developer's .env (tests/test_submission_config.py checks that both agree).
# No endpoint or key here: BASE_URL / API_KEY come from the environment at run time.
LLM_NAME=swiss-ai/Apertus-v1.5-70B-thinking
NLI_STRATEGY=hybrid
NLI_TOP_K=8
PASSAGE_CHARS=0
PAGE_MAX_CHARS=3000
PROMPT_MODE=ids
IDS_REASON=false
PROMPT_SHORT=false
FEW_SHOT=false
THINKING=false
THINKING_MAX_TOKENS=1500
THINKING_BUDGET=0
TRANSLATE_CLAIM=false
SPEAKER_AWARE=false
SPEAKER_BOOST=2
LEGAL_TEXT_MAX_PAGES=0
REFERENCE_MAX_CHARS=0
SPEAKER_HINT=false
NUMERIC_OVERRIDE=false
EVIDENCE_POLICY=raw_pages_and_blocks
CACHE_SINGLE_FLIGHT=false
SOURCE_PAGES_LAZY=true
RETRIEVAL_QUERY_MODE=union
EVIDENCE_SPLIT=2,2
EVIDENCE_FILL=true
EVIDENCE_MAX_ITEMS=5
EVIDENCE_MAX_CHARS=4800
EVIDENCE_ON_NEUTRAL=false
NLI_BATCH_WORKERS=4
LLM_STREAMING=false
LLM_REQUEST_TIMEOUT_S=600
LLM_JSON_REPAIR=true
LLM_MAX_RETRIES=6
LLM_RETRY_BUDGET_S=120
MOCK_APERTUS=false
