# Every pipeline setting with its default, i.e. exactly what the submission image runs (the image sets none of
# them). tests/test_submission_config.py checks the values against src/config.py; scripts/run_decision.py runs
# decision runs with them (except endpoint, key and cache paths). Copy to .env and set API_KEY for local use.

# Apertus / LLM endpoint (CSCS). The official evaluation injects BASE_URL (its token-counting proxy) and API_KEY;
# the older LLM_BASE_URL / LLM_API_KEY names still work as a fallback.
LLM_NAME=swiss-ai/Apertus-v1.5-70B-thinking
BASE_URL=https://api.inference.cscs.ch/v1
API_KEY=your_api_key_here
# Legacy LLM_BASE_URL/LLM_API_KEY are accepted; runtime variables take priority.

# Context strategy: 'hybrid' (recommended), 'retrieval' or 'full'; prompt mode: 'ids' (recommended), 'json' or 'compact'
NLI_STRATEGY=hybrid
NLI_TOP_K=8
PROMPT_MODE=ids
PASSAGE_CHARS=0       # 0 = whole pages as passages
PAGE_MAX_CHARS=3000   # clip over-long pages to their best-matching window (0 = off)
SPEAKER_BOOST=2       # always include the named side's 2 best argument pages (0 = off)
NLI_WORKERS=4         # cases processed in parallel by the batch CLI (NLI_BATCH_WORKERS works too)

# Evidence (task A, scored as Hit@5): first two cited pages in halves, free slots: best third of further pages
EVIDENCE_SPLIT=2,2
EVIDENCE_FILL=true
EVIDENCE_MAX_ITEMS=5
EVIDENCE_MAX_CHARS=4800
EVIDENCE_ON_NEUTRAL=false

# Optional: set to 'true' for offline mock testing without API key
MOCK_APERTUS=false

# Experiments (off by default, see track_2a/docs/experiments.md and docs/independent_experiments.md)
THINKING=false             # true: reason before answering, +2 F1 on dev, ~11x latency
THINKING_MAX_TOKENS=1500
THINKING_BUDGET=0
TRANSLATE_CLAIM=false      # true: translate cross-lingual claims for the NLI prompt, no gain
IDS_REASON=false
PROMPT_SHORT=false
FEW_SHOT=false
SPEAKER_AWARE=false
SPEAKER_HINT=false
NUMERIC_OVERRIDE=false
LEGAL_TEXT_MAX_PAGES=0     # E1: at most n legal-text pages in the task A context (rejected)
REFERENCE_MAX_CHARS=6000   # E2 (adopted): task B, longer references cut to their best-matching chunks (0 = whole reference)
A_COMPACT_PROMPT=false     # E7: compact task A label rules appended to the task A prompt (+~97 input tokens/case);
                           # evaluated on 1,488 cases, off by default (docs/independent_experiments.md, section 7)

# Submission defaults (see track_2a/docs/experiments.md, merge of both lines). Output stays capped; no streaming.
LLM_JSON_REPAIR=true
LLM_STREAMING=false
LLM_REQUEST_TIMEOUT_S=600
LLM_MAX_RETRIES=6
LLM_RETRY_BUDGET_S=120
EVIDENCE_POLICY=raw_pages_and_blocks   # alternatives: legacy, raw_pages
CACHE_SINGLE_FLIGHT=false
SOURCE_PAGES_LAZY=true
BOOKLET_CACHE_DIR=/tmp/fact-attack/booklets
RETRIEVAL_QUERY_MODE=union   # alternatives: original, translated; NLI claim stays original
QUERY_TRANSLATION_CACHE_DIR=/tmp/fact-attack/queries
# REQUEST_JOURNAL_PATH=/output/requests.api.jsonl
